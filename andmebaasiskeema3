SET NAMES utf8mb4;
SET time_zone = '+00:00';
SET sql_mode = 'NO_AUTO_VALUE_ON_ZERO';

START TRANSACTION;

-- Turvalisuse mõttes: vältida FK kontrolli ümberkujunduse ajal
SET @OLD_FOREIGN_KEY_CHECKS = @@FOREIGN_KEY_CHECKS;
SET FOREIGN_KEY_CHECKS = 0;

/* ------------------------------------------------------------------
   1) LIKES: 1 kasutaja saab 1 sõnumit laikida vaid korra
   - eemaldame duplikaadid
   - eemaldame id veeru (kui olemas)
   - seame komposiit-PK (messageId, userId)
   ------------------------------------------------------------------ */

-- 1.1 Eemalda duplikaadid, jättes alles madalaima id
-- (eeldame, et algses skeemis oli likes.id BIGINT/INT PK)
DELETE l1 FROM `likes` l1
JOIN `likes` l2
  ON l1.`messageId` = l2.`messageId`
 AND l1.`userId`    = l2.`userId`
 AND l1.`id`        > l2.`id`;

-- 1.2 Eemalda olemasolev PK ja id-veerg
ALTER TABLE `likes`
  DROP PRIMARY KEY;

-- Kui id eksisteerib, eemaldame. (MariaDB toetab IF EXISTS)
ALTER TABLE `likes`
  DROP COLUMN IF EXISTS `id`;

-- 1.3 Sea komposiit-primaarvõti
ALTER TABLE `likes`
  ADD PRIMARY KEY (`messageId`, `userId`);



/* ------------------------------------------------------------------
   2) MODELS: mudelite register (Model 1, Model 1.5, gpt-4o-mini, jne)
   ------------------------------------------------------------------ */
CREATE TABLE IF NOT EXISTS `models` (
  `id` INT(10) UNSIGNED NOT NULL AUTO_INCREMENT,
  `name` VARCHAR(100) NOT NULL,
  `provider` VARCHAR(100) DEFAULT NULL,
  `version` VARCHAR(50) NOT NULL DEFAULT '',
  `context_window_tokens` INT(10) UNSIGNED DEFAULT NULL,
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` TIMESTAMP NULL DEFAULT NULL ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uq_models_name_version` (`name`, `version`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci;



/* ------------------------------------------------------------------
   3) MESSAGES: roll, nullable userId, seos mudeliga, tokenite arvestus
   ------------------------------------------------------------------ */

-- 3.1 Lisa roll (kui puudub)
ALTER TABLE `messages`
  ADD COLUMN IF NOT EXISTS `role` ENUM('user','assistant','system') NOT NULL DEFAULT 'user' AFTER `userId`;

-- 3.2 Kohanda userId NULL-itavaks ja muuda FK ON DELETE SET NULL
-- NB! Sõltub olemasoleva FK nimest; allpool kasutame tüüpilist genereeritud nime.
-- Kui nimi ei klapi, muuda 'messages_ibfk_2' vastavaks.
-- Drop FK -> muutus -> add FK ON DELETE SET NULL
-- Kui DROP ebaõnnestub, kontrolli olemasolevaid piiranguid: SHOW CREATE TABLE messages;
ALTER TABLE `messages` DROP FOREIGN KEY `messages_ibfk_2`;

ALTER TABLE `messages`
  MODIFY COLUMN `userId` INT(10) UNSIGNED NULL;

ALTER TABLE `messages`
  ADD CONSTRAINT `messages_ibfk_2`
  FOREIGN KEY (`userId`) REFERENCES `users`(`id`)
  ON DELETE SET NULL
  ON UPDATE CASCADE;

-- 3.3 Lisa viide mudelile
ALTER TABLE `messages`
  ADD COLUMN IF NOT EXISTS `model_id` INT(10) UNSIGNED NULL AFTER `role`;

ALTER TABLE `messages`
  ADD CONSTRAINT `messages_ibfk_3`
  FOREIGN KEY (`model_id`) REFERENCES `models`(`id`)
  ON DELETE SET NULL
  ON UPDATE CASCADE;

-- 3.4 Tokenite ja metrika veerud
ALTER TABLE `messages`
  ADD COLUMN IF NOT EXISTS `prompt_tokens` INT(10) UNSIGNED NULL AFTER `message`,
  ADD COLUMN IF NOT EXISTS `completion_tokens` INT(10) UNSIGNED NULL AFTER `prompt_tokens`;

-- Virtuaalne summa (genereeritud veerg)
-- Kui veerg juba olemas, käsk vaikitakse maha IF NOT EXISTS abil (MariaDB 10.2+).
ALTER TABLE `messages`
  ADD COLUMN IF NOT EXISTS `total_tokens` INT(10)
    AS (IFNULL(`prompt_tokens`,0) + IFNULL(`completion_tokens`,0)) VIRTUAL;

ALTER TABLE `messages`
  ADD COLUMN IF NOT EXISTS `latency_ms` INT(10) UNSIGNED NULL AFTER `total_tokens`,
  ADD COLUMN IF NOT EXISTS `cost_usd` DECIMAL(12,6) NULL AFTER `latency_ms`;

-- 3.5 Backfill: veendu, et roll oleks täidetud
UPDATE `messages` SET `role` = 'user' WHERE `role` IS NULL;



/* ------------------------------------------------------------------
   4) Vestluste jagamine ja mitme osalejaga vestlused
   ------------------------------------------------------------------ */

CREATE TABLE IF NOT EXISTS `conversation_participants` (
  `conversationId` INT(10) UNSIGNED NOT NULL,
  `userId` INT(10) UNSIGNED NOT NULL,
  `role` ENUM('owner','editor','viewer') NOT NULL DEFAULT 'viewer',
  `joined_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`conversationId`, `userId`),
  CONSTRAINT `cp_conversation_fk` FOREIGN KEY (`conversationId`) REFERENCES `conversations`(`id`) ON DELETE CASCADE ON UPDATE CASCADE,
  CONSTRAINT `cp_user_fk`         FOREIGN KEY (`userId`)        REFERENCES `users`(`id`)         ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci;

CREATE TABLE IF NOT EXISTS `conversation_shares` (
  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  `conversationId` INT(10) UNSIGNED NOT NULL,
  `share_token` CHAR(32) NOT NULL,
  `access` ENUM('viewer','editor') NOT NULL DEFAULT 'viewer',
  `expires_at` DATETIME NULL,
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uq_share_token` (`share_token`),
  CONSTRAINT `cs_conversation_fk` FOREIGN KEY (`conversationId`) REFERENCES `conversations`(`id`) ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_uca1400_ai_ci;



/* ------------------------------------------------------------------
   5) TRIGGERID: rolli ja väljade loogika (INSERT/UPDATE)
   ------------------------------------------------------------------ */
DELIMITER //

CREATE TRIGGER `trg_messages_role_check_bi`
BEFORE INSERT ON `messages`
FOR EACH ROW
BEGIN
  -- user-sõnumil peab olema userId
  IF NEW.`role` = 'user' AND NEW.`userId` IS NULL THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'messages.role=user nõuab userId väärtust';
  END IF;

  -- assistant/system sõnumil peab olema model_id
  IF NEW.`role` IN ('assistant','system') AND NEW.`model_id` IS NULL THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'messages.role=assistant/system nõuab model_id väärtust';
  END IF;
END//

CREATE TRIGGER `trg_messages_role_check_bu`
BEFORE UPDATE ON `messages`
FOR EACH ROW
BEGIN
  -- user-sõnumil peab olema userId
  IF NEW.`role` = 'user' AND NEW.`userId` IS NULL THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'messages.role=user nõuab userId väärtust';
  END IF;

  -- assistant/system sõnumil peab olema model_id
  IF NEW.`role` IN ('assistant','system') AND NEW.`model_id` IS NULL THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'messages.role=assistant/system nõuab model_id väärtust';
  END IF;
END//

DELIMITER ;



